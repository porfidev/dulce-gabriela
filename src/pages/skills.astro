---
import '../pages/index.styles.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
---

<BaseLayout>
    <SectionTitle title="habilidades" />

    <div class="intro-text-wrapper">
    <p class="intro-text">Mi experiencia combina creatividad, conocimientos técnicos y dominio de herramientas especializadas para desarrollar
        proyectos visuales de alto impacto.</p>
    </div>

    <div class="skills-content">
        <div>
            <div class="knowledge-wrapper"><span class="knowledge-text">Diseño</span></div>
        </div>
        <div>
            <div class="skill-description">
                <div class="icons-wrapper">
                    <img src="/images/ai.svg" class="skill-icon"/>
                    <img src="/images/ps.svg" class="skill-icon" />
                </div>
                <div>
                    <p>Paquetería Adobe, Photoshop, Illustrator</p>
                </div>
            </div>
            <div class="skill-description">
                <div class="icons-wrapper">
                    <img src="/images/figma.svg" class="skill-icon" />
                </div>
                <div>
                    <p>Figma</p>
                </div>
            </div>
            <div class="skill-description">
                <div class="icons-wrapper">
                    <img src="/images/ia.svg" class="skill-icon" />
                </div>
                <div>
                    <p>Herramientas de IA aplicadas al diseño</p>
                </div>
            </div>
        </div>
        <div>
            <div class="knowledge-wrapper"><span class="knowledge-text">Producción gráfica</span></div>
        </div>
        <div>
            <div class="skill-description">
                <div class="icons-wrapper">
                    <img src="/images/rasterink.svg" class="skill-icon"/>
                </div>
                <div>
                    <p>RasterLInk</p>
                </div>
            </div>
            <div class="skill-description">
                <div class="icons-wrapper">
                    <img src="/images/epson.svg" class="skill-icon"/>
                    <img src="/images/mimaki.svg" class="skill-icon"/>
                </div>
                <div>
                    <p>Plotters Mimaki, Plotters Epson, Plotter DTF</p>
                </div>
            </div>
        </div>
        <div>
            <div class="knowledge-wrapper"><span class="knowledge-text">Conocimientos</span></div>
        </div>
        <div>
            <div class="skill-description">
                <div class="icons-wrapper">
                    <img src="/images/rasterink.svg" class="skill-icon"/>
                </div>
                <div>
                    <p>Desarrollo de fichas técnicas</p>
                </div>
            </div>
            <div class="skill-description">
                <div class="icons-wrapper">
                    <img src="/images/fb.svg" class="skill-icon"/>
                    <img src="/images/insta.svg" class="skill-icon"/>
                </div>
                <div>
                    <p>Manejo de redes sociales</p>
                </div>
            </div>
            <div class="skill-description">
                <div class="icons-wrapper">
                    <img src="/images/cmyk.png" class="skill-icon"/>
                </div>
                <div>
                    <p>Sublimación, serigrafía, dtf, vinil, tampografía, offset, bordado</p>
                </div>
            </div>
        </div>
    </div>

    <img class="image-photo" src="/images/skill-promo.webp" />
</BaseLayout>

<style>
    .image-photo {
        position: absolute;
        bottom: 0;
        border-bottom-left-radius: 62px;
        z-index: 2;
    }

    .intro-text {
        font-family: 'Be Vietnam Pro', sans-serif;
        font-weight: 400;
        font-size: 14px;
    }

    .intro-text-wrapper {
        position: absolute;
        top: 176px;
        left: 416px;
        width: 640px;
    }

    .skills-content {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: 260px;
        left: 600px;
    }

    .knowledge-wrapper {
        background-color: rgba(135, 108, 108, 0.16);
        border-radius: 20px;
        height: 42px;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px 30px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.10);
        width: fit-content;
    }

    .knowledge-text {
        font-family: 'Be Vietnam Pro', sans-serif;
        font-weight: 400;
        font-size: 12px;
        line-height: 15px;
        color: #000000;
        text-transform: uppercase;
    }

    .skill-description {
        display: flex;
        flex-direction: row;
        gap: 24px;
        margin-top: 8px;
        margin-bottom: 4px;
    }

    .icons-wrapper {
        display: flex;
        flex-direction: row;
        gap: 16px;
        justify-content: flex-end;
        padding-top: 4px;
        padding-bottom: 4px;
        min-width: 100px;
    }

    .skill-icon {
        width: 35px;
        height: 35px;
    }

    p {
        font-family: 'Be Vietnam Pro', sans-serif;
        font-weight: 400;
        font-size: 14px;
        color: #000000;
    }
</style>
