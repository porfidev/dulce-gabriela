---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import ShowProjectButton from '../../../components/ShowProjectButton.astro';

import image1 from './images/main1.webp';
import image2 from './images/main2.webp';
import image3 from './images/main3.webp';
---

<BaseLayout>
    <SectionTitle title="portafolio" subtitle="otros proyectos" />


    <div class="submenu-wrapper">
        <ShowProjectButton link="/portfolio/others/clothes/" />
    </div>

    <section class="portfolio-section-content">
        <p>
            Selección de proyectos de diseño textil y desarrollo de producto realizados para diferentes marcas. Incluye creación y adaptación de estampados, desarrollo de gráficos para productos, preparación de artes para producción y aplicación de diseños en diferentes formatos y materiales textiles
        </p>
    </section>


    <img class="image1" src={image1.src} />
    <img class="image2" src={image2.src} />
    <img class="image3" src={image3.src} />
</BaseLayout>

<style>
    .submenu-wrapper {
        position: absolute;
        right: 25px;
        top: 150px;
    }

    .portfolio-section-content {
        position: absolute;
        width: 665px;
        height: 48px;
        top: 289px;
        left: 405px;
        text-align: center;

        font-family: 'Be Vietnam Pro', sans-serif;
        font-weight: 400;
        font-size: 14px;

        h3 {
            text-transform: uppercase;
        }
    }

    [class^="image"] {
        position: absolute;
    }

    .image1 {
        top: 392px;
        left: 36px;
    }

    .image2 {
        top: 414px;
        left: 442px;
    }

    .image3 {
        top: 415px;
        right: 40px;
    }


</style>
