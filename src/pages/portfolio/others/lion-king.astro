---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import InnerNavigation from '../../../components/InnerNavigation.astro';

import image1 from './images/lionking1.webp';
import image2 from './images/lionking2.webp';
---

<BaseLayout>
    <SectionTitle title="portafolio" subtitle="Rey León" />

    <InnerNavigation
            prevLink="/portfolio/others/cheetos/"
            nextLink="/portfolio/webpages/"
    />

    <section class="portfolio-section-content">
        <h4>REY LEÓN</h4>
        <p>
            Con esta marca  elaboré propuestas para souvienirs de la obra de teatro, manteniendo la escencia de la marca
            en cada producto.
        </p>
    </section>

    <img class="image1" src={image1.src} />
    <img class="image2" src={image2.src} />
</BaseLayout>

<style>
    .portfolio-section-content {
        position: absolute;
        width: 414px;
        height: 90px;
        top: 260px;
        right: 228px;

        font-family: 'Be Vietnam Pro', sans-serif;
        font-weight: 400;
        font-size: 14px;

        h3 {
            text-transform: uppercase;
        }
    }

    [class^="image"] {
        position: absolute;
    }

    .image1 {
        left: 84px;
        bottom: 84px;
    }

    .image2 {
        bottom: 74px;
        right: 43px;
    }
</style>
