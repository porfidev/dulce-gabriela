---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionTitle from '../../../components/SectionTitle.astro';

import image1 from './images/sport1.webp';
import image2 from './images/sport2.webp';
import image3 from './images/sport3.webp';
import InnerNavigation from '../../../components/InnerNavigation.astro';
---

<BaseLayout>
    <SectionTitle title="portafolio" subtitle="puffin drinkwear" />

    <InnerNavigation
      prevLink="/portfolio/puffin-drinkwear/"
      nextLink="/portfolio/puffin-drinkwear/casual"
    />

    <section class="portfolio-section-content">
        <p>
            Desarrollo de tech pack para los
            fabricantes con las especificaciones
            exactas para la elaboración del producto
            incluidos: bocetos, medidas, materiales
            y variantes de color.
        </p>
    </section>

    <img class="image1" src={image1.src} />
    <img class="image2" src={image2.src} />
    <img class="image3" src={image3.src} />
</BaseLayout>

<style>
    .portfolio-section-content {
        position: absolute;
        width: 270px;
        height: 85px;
        bottom: 212px;
        left: 344px;

        font-family: 'Be Vietnam Pro', sans-serif;
        font-weight: 400;
        font-size: 14px;
        text-align: center;

        h3 {
            text-transform: uppercase;
        }
    }

    .image1, .image2, .image3 {
        position: absolute;
    }

    .image1 {
        right: 139px;
        top: 214px;
    }

    .image2 {
        left: 86px;
        top: 246px;
    }

    .image3 {
        left: 127px;
        bottom: 48px;
    }
</style>
