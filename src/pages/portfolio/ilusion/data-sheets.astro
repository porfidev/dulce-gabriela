---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionTitle from '../../../components/SectionTitle.astro';

import image1 from './images/ficha1.webp';
import image2 from './images/ficha2.webp';
import image3 from './images/ficha3.webp';
import image4 from './images/ficha4.webp';
import image5 from './images/ficha5.webp';
import InnerNavigation from '../../../components/InnerNavigation.astro';
---

<BaseLayout>
    <SectionTitle title="portafolio" subtitle="ilusión" />

    <InnerNavigation
            prevLink="/portfolio/ilusion/"
            nextLink="/portfolio/ilusion/bages"
    />

    <section class="portfolio-section-content">
        <p>
            Desarrollo de fichas técnicas para el área de producció n y maquilas externas,
            especificaciones de materiales, tipo de impresión,  instrucciones de  costura  y avíos.
            Detallando medidas por prenda y tallas.
        </p>
    </section>

    <img class="image1" src={image1.src} />
    <img class="image2" src={image2.src} />
    <img class="image3" src={image3.src} />
    <img class="image4" src={image4.src} />
    <img class="image5" src={image5.src} />
</BaseLayout>

<style>
    .portfolio-section-content {
        position: absolute;
        width: 575px;
        height: 52px;
        top: 212px;
        left: 476px;

        font-family: 'Be Vietnam Pro', sans-serif;
        font-weight: 400;
        font-size: 14px;
        text-align: center;

        h3 {
            text-transform: uppercase;
        }
    }

    [class^="image"] {
        position: absolute;
    }

    .image1 {
        left: 147px;
        top: 307px;
    }

    .image2 {
        left: 518px;
        top: 300px;
    }

    .image3 {
        top: 290px;
        right: 103px;
    }

    .image4 {
        top: 600px;
        left: 384px;
    }

    .image5 {
        top: 592px;
        left: 700px;
    }
</style>
