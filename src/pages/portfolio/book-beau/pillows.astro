---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import InnerNavigation from '../../../components/InnerNavigation.astro';


import image1 from './images/p1.webp';
import image2 from './images/p2.webp';
import image3 from './images/p3.webp';
---

<BaseLayout>
    <SectionTitle title="portafolio" subtitle="book beau" />

    <InnerNavigation
            prevLink="/portfolio/book-beau/bookshell"
            nextLink="/portfolio/book-beau/bages"
    />

    <img src={image1.src} class="image1">
    <p class="description-text text1">
        Coordinación con la muestrista durante la elaboración para validar acabados, proporciones y la correcta aplicación de cada diseño antes de su producción.</p>

    <img src={image2.src} class="image2">
    <p class="description-text text2">
        Diseño y adaptación de ilustraciones, patrones y estampados para fundas de Reading Pillows, otro producto de la marca, ajustando cada propuesta a las dimensiones y especificaciones del producto.    </p>

    <img src={image3.src} class="image3">
</BaseLayout>

<style>
    .image1, .image2, .image3 {
        position: absolute;
    }

    .image1 {
        left: 37px;
        top: 236px;
    }

    .image2 {
        left: 483px;
        top: 223px;
    }

    .image3 {
        left: 940px;
        top: 307px;
    }

    p.description-text {
        position: absolute;
        text-align: center;
        font-family: 'Be Vietnam Pro', sans-serif;
        font-weight: 400;
        font-size: 14px;
    }

    .text1 {
        width: 336px;
        height: 85px;
        left: 48px;
        top: 720px;
    }

    .text2 {
        width: 336px;
        height: 85px;
        left: 520px;
        top: 733px;
    }
</style>
