---

type Props = {
  link: string;
}

const { link } = Astro.props;
---

<a href={link} class="button-wrapper">
    <span class="button-text">Ver proyecto</span>
    <img src="/images/flecha_link.svg"/>
</a>


<style>
    .button-wrapper {
        width: fit-content;
        height: 52px;
        background-color: rgba(154, 122, 192, 0.5);
        border-radius: 20px;
        gap: 5px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 8px 6px 16px;
        text-decoration: none;
        color: inherit;

        .button-text {
            text-decoration: none;
            color: #FFFFFF;
            font-family: 'Bebas Neue', sans-serif;
            font-weight: 400;
            font-size: 24px;
        }
    }

    .button-wrapper:hover {
        background-color: rgba(154, 122, 192, 1);
    }
</style>
