---
const currentPath = Astro.url.pathname;

const links = [
    { label: 'Inicio', href: '/' },
    { label: 'Habilidades', href: '/skills' },
    { label: 'Portafolio', href: '/portfolio' },
    { label: 'Contacto', href: '/contact' },
];
---
<ul class="navigation-menu">
    {links.map((link) => (
      <li class:list={['navigation-item', { active: link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href)}]}>
          <a href={link.href}>{link.label}</a>
      </li>
    ))}
</ul>

<style>
    .navigation-menu {
        display: flex;
        flex-direction: row;
        height: 44px;
        gap: 40px;
        top: 44px;
        left: 540px;
        position: absolute;
        margin: 0;
        padding: 0;
        width: fit-content;

    }

    .navigation-item {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 70px;
        height: 44px;
        list-style: none;
        font-family: 'Be Vietnam Pro', sans-serif;
        font-size: 20px;
        color: rgba(122, 111, 130, 1);
        white-space: nowrap;
        flex-shrink: 0;
        cursor: pointer;
    }

    .navigation-item:hover,
    .navigation-item.active{
        background-color: rgba(154, 122, 192, 1);
        border-radius: 10px;
        color: rgba(255, 255, 255, 1);
    }

    .navigation-item a {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        width: 100%;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }
</style>
