---
import '../pages/index.styles.css';

type Props = {
    title: string;
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
---
<div class="section-title">
    <span class="section-title-text">{title}</span>

    {subtitle &&
      <div class="section-subtitle">
        <img src="/images/subtitle_arrow.svg" class="subtitle-arrow"/>
        <span class="section-subtitle-text">{subtitle}</span>
    </div>
    }
</div>

<style>
    .section-title {
        position: absolute;
        width: fit-content;
        height: 76px;
        border-radius: 20px;
        top: 92px;
        left: 135px;
        border-width: 1px;
        backdrop-filter: blur(20px);
        box-shadow: 0px 4px 30px 0px rgba(0, 0, 0, 0.06);
        background-color: rgba(135, 108, 108, 0.16);
        padding: 24px 20px 20px;

        display: flex;
        flex-direction: column;
        justify-content: center;
        z-index: 2;

        overflow: visible;
    }

    .section-title-text {
        font-family: 'Bebas Neue', sans-serif;
        font-weight: 400;
        font-size: 54px;
        color: #B53ED3;
        line-height: 1;
    }

    .section-subtitle {
        position: absolute;
        height: 47px;
        top: 80px;
        left: 80px;
        width: 260px;
    }
    .section-subtitle-text {
        font-family: 'Bebas Neue', sans-serif;
        font-weight: 400;
        font-size: 32px;
        color: #000000;
    }

    .subtitle-arrow {
        width: 54px;
        height: 47px;
        margin-right: 10px;
    }
</style>
